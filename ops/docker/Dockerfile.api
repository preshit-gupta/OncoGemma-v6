# ==============================================================================
# OncoGemma v6 - FastAPI Control Plane Container (Cloud Run)
# Multi-stage, non-root API image (SPEC-11 §3).
#
# The API installs the worker's lockfile, not requirements/api.lock.txt: its routers read
# slides and place HPFs (OpenSlide, SciPy, Shapely), and the process runs pipeline stages
# itself (the RUN_IN_PROCESS_WORKER poll loop and the Cloud Tasks webhook). A slimmer
# image needs those moved out of the API first. tools/check_image_imports.py enforces this.
# ==============================================================================

# --- Stage 1: Builder ---
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libvips-dev \
    libopenslide-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements/worker.lock.txt /app/requirements/worker.lock.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements/worker.lock.txt

# --- Stage 2: Runtime Runner ---
FROM python:3.12-slim AS runner

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libvips42 \
    libopenslide0 \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

# Create non-root runtime user
RUN useradd -u 10001 -m -s /bin/bash appuser

# Copy backend application source and configs
COPY backend /app/backend
COPY configs /app/configs
COPY models /app/models
RUN rm -f /app/backend/.env* && \
    chown -R appuser:appuser /app

USER appuser
WORKDIR /app/backend

# Default Cloud Run port is 8080
ENV PORT=8080
EXPOSE 8080

CMD exec python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --workers 1
