    "Metric": {
      "additionalProperties": false,
      "description": "A metric with its bootstrap interval over patients (contract ``Metric``; SPEC-00 \u00a72.4).\n\n``final`` when the 95% CI half-width is at most 0.05, ``provisional`` otherwise, ``invalid``\nwhen there is no value or the run broke the measurement-validity gate (SPEC-00 \u00a72.5).",
      "properties": {
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci High"
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci Low"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "status": {
          "enum": [
            "final",
            "provisional",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "ci_low",
        "ci_high",
        "n",
        "status"
      ],
      "title": "Metric",
      "type": "object"
    },
